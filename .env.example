# Placeholder names only. Never commit real values.
# Local AWS credentials come from `aws configure`; EC2 uses an instance role.
AWS_DEFAULT_REGION=ap-south-1
DVC_S3_BUCKET=your-dvc-bucket-name
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest-local

# Local monitoring stack (docker compose). Set a real password in your own gitignored .env.
GRAFANA_ADMIN_PASSWORD=
