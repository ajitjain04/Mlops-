        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(adaptivephish_http_requests_total{status=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "HTTP 5xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(adaptivephish_http_requests_total{status=~\"4..\"}[1m]))",
          "legendFormat": "HTTP 4xx"
        }
      ]
